{
  "hosting": {
    "source": "**/*.@(js|css|html)",
    "headers": [
      { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
    ],
    "public": "./",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/.github/**",
      "**/.git/**"
    ]
  }
}
